#!/usr/bin/env bash
# test stub for ip(8) — state kept under $TEST_ROOT/state
ST="${TEST_ROOT:?}/state"
mkdir -p "$ST/tunnels"
touch "$ST/addrs"

while [[ "${1:-}" == -* ]]; do shift; done
obj="${1:-}"; sub="${2:-}"

case "$obj" in
  tunnel)
    case "$sub" in
      add)
        # Model the kernel's own requirements instead of accepting anything. A GRE
        # tunnel without a usable local address cannot pass traffic, so a stub that
        # silently accepts one lets that bug reach production.
        loc="" rem=""
        prev=""
        for a in "$@"; do
          if [[ "$prev" == "local" ]]; then loc="$a"; fi
          if [[ "$prev" == "remote" ]]; then rem="$a"; fi
          prev="$a"
        done
        if [[ -z "${loc:-}" || ! "$loc" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ || "$loc" == "0.0.0.0" ]]; then
          echo "Error: argument \"local\" is wrong: \"${loc:-<empty>}\" is not a valid address." >&2
          exit 2
        fi
        if [[ -z "${rem:-}" || ! "$rem" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ || "$rem" == "0.0.0.0" ]]; then
          echo "Error: argument \"remote\" is wrong: \"${rem:-<empty>}\" is not a valid address." >&2
          exit 2
        fi
        echo "$*" > "$ST/tunnels/$3"
        exit 0 ;;
      del)
        rm -f "$ST/tunnels/$3"
        awk -v d="$3" '$NF != d' "$ST/addrs" > "$ST/addrs.tmp" 2>/dev/null || true
        mv "$ST/addrs.tmp" "$ST/addrs"
        exit 0 ;;
      show)
        # Report each tunnel's REAL local and remote addresses, in ip(8)'s own order.
        # This used to print a hardcoded, reversed pair ("remote <this host> local
        # <peer>"), which made any code reading the endpoint from `ip` get the wrong
        # address — or, with a filter, the wrong tunnel.
        want="${3:-}"
        for t in "$ST/tunnels"/*; do
          [[ -e "$t" ]] || continue
          nm="$(basename "$t")"
          [[ -n "$want" && "$want" != "$nm" ]] && continue
          rec="$(cat "$t")"
          loc=""; rem=""; prev=""
          for a in $rec; do
            [[ "$prev" == "local" ]] && loc="$a"
            [[ "$prev" == "remote" ]] && rem="$a"
            prev="$a"
          done
          echo "$nm: gre/ip remote ${rem:-0.0.0.0} local ${loc:-0.0.0.0} ttl 255"
        done
        exit 0 ;;
    esac ;;
  link)
    case "$sub" in
      show)
        if [[ "${3:-}" == "type" ]]; then
          [[ "${4:-}" == "gre" ]] || exit 0
          i=2
          for t in "$ST/tunnels"/*; do
            [[ -e "$t" ]] || continue
            _n="$(basename "$t")"
            _m="$(cat "$ST/mtu.$_n" 2>/dev/null || echo 1476)"
            echo "$i: $_n: <POINTOPOINT,NOARP,UP,LOWER_UP> mtu $_m"
            i=$((i+1))
          done
          exit 0
        fi
        if [[ -n "${3:-}" ]]; then
          if [[ "$3" == "lo" ]]; then
            echo "lo: <LOOPBACK,UP,LOWER_UP> mtu 65536 state UNKNOWN mode DEFAULT"
            exit 0
          fi
          if [[ "$3" == "eth0" ]]; then
            # The underlay NIC is a real 1500-byte Ethernet, not the tunnel's MTU.
            # Reporting the tunnel value here would make every MTU computation agree
            # with whatever the tunnel already had.
            m="$(cat "$ST/mtu.eth0" 2>/dev/null || echo 1500)"
            echo "eth0: <BROADCAST,MULTICAST,UP,LOWER_UP> mtu $m state UP mode DEFAULT"
            exit 0
          fi
          if [[ -f "$ST/tunnels/$3" ]]; then
            # Report an MTU so code that reads the live interface MTU has something to
            # read. `link set dev X mtu N` records it, which is what makes an MTU change
            # observable to the next diagnostic (and lets a rollback be verified).
            m="$(cat "$ST/mtu.$3" 2>/dev/null || echo 1476)"
            echo "$3: <POINTOPOINT,NOARP,UP,LOWER_UP> mtu $m state UNKNOWN mode DEFAULT"
            exit 0
          fi
          exit 1
        fi
        # No device named: list every interface, as real ip(8) does. Reporting nothing
        # would make anything that enumerates interfaces silently see an empty host.
        echo "lo: <LOOPBACK,UP,LOWER_UP> mtu 65536 state UNKNOWN mode DEFAULT"
        _e="$(cat "$ST/mtu.eth0" 2>/dev/null || echo 1500)"
        echo "eth0: <BROADCAST,MULTICAST,UP,LOWER_UP> mtu $_e state UP mode DEFAULT"
        _i=2
        for t in "$ST/tunnels"/*; do
          [[ -e "$t" ]] || continue
          _n="$(basename "$t")"
          _m="$(cat "$ST/mtu.$_n" 2>/dev/null || echo 1476)"
          echo "$_i: $_n: <POINTOPOINT,NOARP,UP,LOWER_UP> mtu $_m state UNKNOWN mode DEFAULT"
          _i=$(( _i + 1 ))
        done
        exit 0 ;;
      set)
        # `ip link set dev IFACE mtu VALUE [up]` — the manager uses this for an
        # MTU-only change that must not recreate the interface.
        _dev=""; _mtu=""; _prev=""
        for _a in "$@"; do
          [[ "$_prev" == "dev" ]] && _dev="$_a"
          [[ "$_prev" == "mtu" ]] && _mtu="$_a"
          _prev="$_a"
        done
        if [[ -n "$_dev" && -n "$_mtu" ]]; then
          echo "$_mtu" > "$ST/mtu.$_dev"
        fi
        exit 0 ;;
    esac ;;
  addr)
    case "$sub" in
      add)
        echo "$3 $5" >> "$ST/addrs"
        exit 0 ;;
      show)
        dev=""
        [[ "${3:-}" == "dev" ]] && dev="${4:-}"
        if [[ -z "$dev" || "$dev" == "lo" ]]; then echo '1: lo    inet 127.0.0.1/8 scope host lo'; fi
        if [[ -z "$dev" || "$dev" == "eth0" ]]; then echo '2: eth0    inet 198.51.100.20/24 scope global eth0'; fi
        n=10
        while read -r a d; do
          [[ -n "$a" ]] || continue
          [[ -n "$dev" && "$d" != "$dev" ]] && continue
          echo "$n: $d    inet $a scope global $d"
          n=$((n+1))
        done < "$ST/addrs"
        exit 0 ;;
    esac ;;
  route)
    if [[ "$sub" == "show" && "${3:-}" == "default" ]]; then
      echo "default via 192.0.2.1 dev eth0"
    elif [[ "$sub" == "get" ]]; then
      echo "${3:-1.1.1.1} via 192.0.2.1 dev eth0 src 198.51.100.20"
    elif [[ "$sub" == "show" ]]; then
      echo "default via 192.0.2.1 dev eth0"
      echo "192.0.2.0/24 dev eth0 proto kernel scope link src 192.0.2.10"
    fi
    exit 0 ;;
esac
exit 0
