# gre-hub runtime install policy.
#
# better-sqlite3 is a NATIVE module. If its install script does not run, npm
# still reports a successful install but `require('better-sqlite3')` then throws
# "Could not locate the bindings file" and the hub cannot open its database at
# all. Recent npm versions (11+) refuse to run dependency install scripts unless
# they are explicitly allowed, so this file is REQUIRED for a working install —
# it must ship inside gre-hub.tar.gz.
#
# `allow-scripts=true` is the documented npm setting; the equivalent allowlist
# also lives in package.json -> allowScripts for versions that read it there.
allow-scripts=true

# Native modules compile from source when no prebuilt binary matches, so a
# toolchain is needed on hosts without one. engine-strict stays off: the hub
# supports any Node >= 18 and a newer runtime must not fail the install.
engine-strict=false
